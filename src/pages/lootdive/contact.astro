---
import BaseLayout from '../../layouts/BaseLayout.astro'
import '../../styles/LootDiveLegal.css'
---

<BaseLayout title="ルートダイブ お問い合わせ">
  <div class="ld-legal-page">
    <div class="ld-legal-container">
      <a href="/lootdive" class="ld-legal-back">&larr; LootDive に戻る</a>

      <div class="ld-legal-content">
        <h1>お問い合わせ</h1>
        <p class="ld-legal-updated">Contact Us</p>

        <div class="ld-contact-success" id="contact-success" hidden>
          <p>お問い合わせを受け付けました。</p>
          <p>内容を確認の上、必要に応じてご連絡いたします。</p>
          <button type="button" class="ld-contact-btn" id="contact-reset">
            新しいお問い合わせを送信
          </button>
        </div>

        <form class="ld-contact-form" id="contact-form">
          <div class="ld-form-group">
            <label for="name">お名前（ニックネーム可）</label>
            <input type="text" id="name" name="name" required maxlength="100" placeholder="例: プレイヤー1" />
          </div>

          <div class="ld-form-group">
            <label for="email">メールアドレス（任意）</label>
            <input
              type="email"
              id="email"
              name="email"
              maxlength="254"
              placeholder="返信が必要な場合はご記入ください"
            />
          </div>

          <div class="ld-form-group">
            <label for="category">カテゴリ</label>
            <select id="category" name="category" required>
              <option value="bug">不具合報告</option>
              <option value="feature">機能要望</option>
              <option value="question">質問</option>
              <option value="other">その他</option>
            </select>
          </div>

          <div class="ld-form-group">
            <label for="message">お問い合わせ内容</label>
            <textarea id="message" name="message" required maxlength="5000" rows="6" placeholder="詳細をご記入ください"
            ></textarea>
          </div>

          <div class="ld-form-error" id="contact-error" hidden>
            送信に失敗しました。時間をおいて再度お試しください。
          </div>

          <button type="submit" class="ld-contact-btn" id="contact-submit">送信する</button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { submitInquiry } from '../../lib/db'

  const form = document.getElementById('contact-form') as HTMLFormElement
  const success = document.getElementById('contact-success') as HTMLElement
  const error = document.getElementById('contact-error') as HTMLElement
  const submit = document.getElementById('contact-submit') as HTMLButtonElement

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const data = new FormData(form)
    error.hidden = true
    submit.disabled = true
    submit.textContent = '送信中...'

    try {
      await submitInquiry({
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        category: String(data.get('category') ?? 'bug'),
        message: String(data.get('message') ?? ''),
      })
      form.reset()
      form.hidden = true
      success.hidden = false
    } catch (err) {
      console.error('Failed to submit inquiry:', err)
      error.hidden = false
    } finally {
      submit.disabled = false
      submit.textContent = '送信する'
    }
  })

  document.getElementById('contact-reset')!.addEventListener('click', () => {
    success.hidden = true
    form.hidden = false
  })
</script>
