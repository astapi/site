---
import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout title="ページが見つかりません">
  <div class="flex flex-col items-center justify-center flex-1 gap-4 px-5 py-[100px] bg-[var(--color-bg)]">
    <h1 class="text-2xl md:text-[32px] font-bold text-[var(--color-text)]">404</h1>
    <p class="text-sm md:text-[15px] text-[var(--color-text-muted)]">お探しのページは見つかりませんでした。</p>
    <a href="/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
      &larr; トップへ戻る
    </a>
  </div>
</SiteLayout>
