{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astapi-net",
  "compatibility_date": "2026-10-01",
  // Astro の静的ビルドを配信するだけ (main なし)。静的アセットへのリクエストは Workers の無料枠を消費しない
  "assets": {
    "directory": "./dist",
    // /article/foo → foo.html のように拡張子なしURLで配信する
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "astapi.net", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
