{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "astapi-admin",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Cloudflare Access で保護するカスタムドメインのみで公開する (workers.dev は無効)
  "routes": [
    { "pattern": "admin.astapi.net", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
